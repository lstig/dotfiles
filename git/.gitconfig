# This is Git's per-user configuration file.
[user]
	name = Luke Stigdon
	signingkey = ~/.ssh/id_rsa.pub
[init]
	defaultBranch = main
[pull]
	rebase = false
[core]
	excludesFile = ~/.config/git/ignore
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[commit]
	gpgsign = true
[gpg]
	format = ssh

# Match remotes by host across scheme URLs (ssh://, https://, with/without
# port) and scp-style (git@host:owner/repo). A bare leading "**" only crosses
# "/" when followed by a slash, so the scheme must be anchored explicitly.
[includeIf "hasconfig:remote.*.url:*://**gitlab.com/**"]
    path = ~/.config/git/gitlab
[includeIf "hasconfig:remote.*.url:*://**gitlab.com:*/**"]
    path = ~/.config/git/gitlab
[includeIf "hasconfig:remote.*.url:*gitlab.com:*/**"]
    path = ~/.config/git/gitlab

[includeIf "hasconfig:remote.*.url:*://**github.com/**"]
    path = ~/.config/git/github
[includeIf "hasconfig:remote.*.url:*://**github.com:*/**"]
    path = ~/.config/git/github
[includeIf "hasconfig:remote.*.url:*github.com:*/**"]
    path = ~/.config/git/github

[includeIf "hasconfig:remote.*.url:*://**codeberg.org/**"]
    path = ~/.config/git/codeberg
[includeIf "hasconfig:remote.*.url:*://**codeberg.org:*/**"]
    path = ~/.config/git/codeberg
[includeIf "hasconfig:remote.*.url:*codeberg.org:*/**"]
    path = ~/.config/git/codeberg

[includeIf "hasconfig:remote.*.url:*://**git.lan.stignet.com/**"]
    path = ~/.config/git/local
[includeIf "hasconfig:remote.*.url:*://**git.lan.stignet.com:*/**"]
    path = ~/.config/git/local
[includeIf "hasconfig:remote.*.url:*git.lan.stignet.com:*/**"]
    path = ~/.config/git/local

[format]
	signoff = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
