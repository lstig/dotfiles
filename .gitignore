# Explicitly allow only certain files for the AI agent packages
agents/**/*
!agents/CONTEXT.md
!agents/.stow-local-ignore
!agents/.pi
!agents/.pi/agent
!agents/.pi/agent/extensions
!agents/.pi/agent/extensions/**/*
!agents/.pi/agent/prompts
!agents/.pi/agent/prompts/**/*
!agents/.pi/agent/skills
!agents/.pi/agent/skills/**/*
!agents/.pi/agent/themes
!agents/.pi/agent/themes/**/*
!agents/.pi/agent/AGENTS.md
!agents/.claude
!agents/.claude/agents
!agents/.claude/agents/**/*
!agents/.claude/skills
!agents/.claude/skills/**/*
!agents/.claude/CLAUDE.md

# ignore local worktrees created by claude
.claude/worktrees/

# zsh files we don't want accidentally commited
.zsh_history

# macOS
.DS_Store

# Editor cruft
*.swp
*~
