# Explicitly allow only certain files for the AI agent packages
pi/**/*
!pi/.pi
!pi/.pi/agent
!pi/.pi/agent/extensions
!pi/.pi/agent/extensions/**/*
!pi/.pi/agent/prompts
!pi/.pi/agent/prompts/**/*
!pi/.pi/agent/skills
!pi/.pi/agent/skills/**/*
!pi/.pi/agent/themes
!pi/.pi/agent/themes/**/*
!pi/.pi/agent/AGENTS.md
claude/**/*
!claude/.claude
!claude/.claude/agents
!claude/.claude/agents/**/*
!claude/.claude/skills
!claude/.claude/skills/**/*
!claude/.claude/CLAUDE.md

# ignore local worktrees created by claude
.claude/worktrees/

# zsh files we don't want accidentally commited
.zsh_history

# macOS
.DS_Store

# Editor cruft
*.swp
*~
